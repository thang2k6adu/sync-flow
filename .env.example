# API Configuration
# - Android Emulator: http://10.0.2.2:3000/api
# - iOS Simulator: http://localhost:3000/api
# - Physical Device: http://<YOUR_LOCAL_IP>:3000/api
API_BASE_URL=http://10.0.2.2:3000/api

# Mock data: true = không gọi backend/Firebase, trả data giả trong lib/data/mocks
USE_MOCK_DATA=false

# Firebase Authentication (Google Sign-In)
GOOGLE_WEB_CLIENT_ID=

# Network Configuration (in milliseconds)
API_CONNECT_TIMEOUT=10000
API_RECEIVE_TIMEOUT=3000

# App Configuration
APP_NAME=Sync Flow
APP_VERSION=1.0.0
